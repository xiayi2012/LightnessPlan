page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff4eb 0, #fffaf6 360rpx, #fff8f3 100%);
  color: #3b2f2a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 18rpx 18rpx 180rpx;
  box-sizing: border-box;
}

.topbar {
  margin: -18rpx -18rpx 28rpx;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #d86e5d, #b95549);
  color: #fff;
  box-shadow: 0 22rpx 46rpx rgba(115, 72, 52, 0.18);
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  font-weight: 800;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 60rpx;
  line-height: 1.15;
  font-weight: 900;
}

.panel,
.card {
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 36rpx rgba(115, 72, 52, 0.08);
}

.panel {
  padding: 32rpx;
  margin-bottom: 22rpx;
}

.panel-title {
  margin-bottom: 20rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.grid-2 .stat,
.grid-2 .card,
.grid-2 .panel {
  flex: 0 0 48.6%;
  width: 48.6%;
  max-width: 48.6%;
  margin-bottom: 18rpx;
}

.grid-2 .panel {
  box-sizing: border-box;
}

.stat {
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.stat-label,
.muted {
  display: block;
  color: #8b7a72;
  font-size: 24rpx;
  font-weight: 800;
}

.stat-value {
  display: block;
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 900;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  font: inherit;
  text-align: center;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f08f78, #d86e5d);
  color: #fff;
  font-weight: 900;
  font-size: 30rpx;
  line-height: 1;
  box-shadow: 0 16rpx 28rpx rgba(216, 110, 93, 0.22);
}

.button.secondary {
  border: 1rpx solid #f0ddd3;
  background: #fff;
  color: #8b7a72;
  box-shadow: none;
}

input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
  font-size: 30rpx;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #8b7a72;
  font-size: 25rpx;
  font-weight: 800;
}

.record,
.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: #fffaf7;
  margin-bottom: 16rpx;
}

.record-main,
.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-main {
  margin-left: 20rpx;
}

.record-title,
.rank-name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.record-meta,
.rank-meta {
  margin-top: 8rpx;
  color: #8b7a72;
  font-size: 24rpx;
}

.badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #fff0e8;
  color: #b95549;
  font-weight: 900;
}

.empty {
  padding: 32rpx;
  color: #8b7a72;
  text-align: center;
}
