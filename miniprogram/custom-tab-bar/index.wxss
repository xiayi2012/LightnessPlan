.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 4rpx;
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(240, 221, 211, 0.95);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -18rpx 36rpx rgba(115, 72, 52, 0.12);
}

.tabbar-item {
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  border-radius: 16rpx;
  color: #8b7a72;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.tabbar-item.active {
  color: #e9826e;
  background: #fff0e8;
}

.tabbar-main {
  transform: translateY(-28rpx);
  gap: 0;
}

.tabbar-main .tabbar-icon {
  width: 92rpx;
  height: 92rpx;
  color: #fff;
  background: linear-gradient(135deg, #f08f78, #d86e5d);
  box-shadow: 0 12rpx 22rpx rgba(216, 110, 93, 0.25);
}

.tabbar-main.active {
  background: transparent;
}

.tabbar-icon {
  position: relative;
  display: block;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
}

.tabbar-icon::before,
.tabbar-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.icon-home::before {
  width: 30rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 4rpx;
}

.icon-home::after {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: translate(-50%, -72%) rotate(45deg);
}

.icon-stats::before {
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: -16rpx 10rpx 0 currentColor, 16rpx -8rpx 0 currentColor;
}

.icon-plus::before,
.icon-plus::after {
  width: 40rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.icon-plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.icon-rank::before {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.icon-rank::after {
  width: 28rpx;
  height: 4rpx;
  background: currentColor;
  transform: translate(-18%, 300%) rotate(45deg);
}

.icon-user::before {
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -85%);
}

.icon-user::after {
  width: 34rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  border-bottom: 0;
  transform: translate(-50%, 35%);
}
