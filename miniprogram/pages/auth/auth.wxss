.auth-page {
  padding-top: 24rpx;
}

.brand {
  position: relative;
  min-height: 220rpx;
  margin-top: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #fff 0%, #fff4eb 100%);
}

.brand::after {
  content: "";
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  width: 168rpx;
  height: 168rpx;
  border: 1rpx solid rgba(233, 130, 110, 0.18);
  border-radius: 50%;
  opacity: 0.7;
}

.brand .eyebrow {
  color: #e9826e;
}

.brand-title {
  display: block;
  margin-top: 16rpx;
  font-size: 88rpx;
  line-height: 1;
  font-weight: 900;
}

.brand-copy {
  display: block;
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #8b7a72;
  line-height: 1.7;
}

.tabs {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #fff0e8;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 88rpx;
  padding: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #8b7a72;
  font-weight: 900;
  line-height: 1;
}

.tab::after {
  border: 0;
}

.tab.active {
  background: #fff;
  color: #b95549;
  box-shadow: 0 12rpx 26rpx rgba(115, 72, 52, 0.09);
}

.grid-2 {
  margin-bottom: 0;
}

.grid-2 .field {
  flex: 0 0 48.6%;
  width: 48.6%;
  max-width: 48.6%;
}
