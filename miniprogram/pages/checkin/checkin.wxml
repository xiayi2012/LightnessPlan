<view class="page">
  <view class="topbar">
    <text class="eyebrow">每日打卡</text>
    <text class="title">体重打卡</text>
  </view>

  <view class="panel">
    <view class="field">
      <view class="field-label">日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker">{{form.date}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">体重 {{unitText}}</view>
      <input type="digit" value="{{form.weight}}" bindinput="onWeightInput" />
      <slider min="{{rangeMin}}" max="{{rangeMax}}" step="0.1" value="{{form.weight}}" activeColor="#e9826e" bindchanging="onWeightSlide" bindchange="onWeightSlide" />
    </view>
    <view class="field">
      <view class="field-label">备注</view>
      <input value="{{form.note}}" data-key="note" bindinput="onInput" />
    </view>
    <view class="checkin-actions">
      <button class="button secondary" bindtap="cancel">不保存返回</button>
      <button class="button" bindtap="submit">{{isEditing ? '保存修改' : '保存打卡'}}</button>
    </view>
  </view>
</view>
