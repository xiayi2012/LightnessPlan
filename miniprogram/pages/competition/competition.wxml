<view class="page">
  <view class="topbar">
    <text class="eyebrow">比赛设置</text>
    <text class="title">比赛设置</text>
  </view>

  <view class="panel">
    <view class="field">
      <view class="field-label">开始日期</view>
      <picker mode="date" value="{{form.startDate}}" bindchange="onDateChange">
        <view class="picker">{{form.startDate}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">比赛天数</view>
      <input type="number" value="{{form.durationDays}}" bindinput="onDurationInput" />
    </view>
    <button class="button" bindtap="submit">保存比赛设置</button>
  </view>
</view>
