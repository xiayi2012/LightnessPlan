.profile-card {
  display: flex;
  align-items: center;
  min-height: 168rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(233, 130, 110, 0.1), rgba(244, 193, 93, 0.14)), #fff;
  box-shadow: 0 16rpx 36rpx rgba(115, 72, 52, 0.08);
  box-sizing: border-box;
}

.profile-avatar {
  flex: 0 0 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #f08f78, #d86e5d);
  color: #fff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 12rpx 22rpx rgba(216, 110, 93, 0.24);
  overflow: hidden;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx 0 24rpx;
  box-sizing: border-box;
}

.profile-name {
  overflow: hidden;
  margin: 8rpx 0;
  font-size: 46rpx;
  line-height: 1.15;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-edit {
  flex: 0 0 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 68rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: #fff;
  color: #b95549;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 26rpx rgba(115, 72, 52, 0.09);
}

.profile-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.profile-stat {
  flex: 0 0 48.6%;
  width: 48.6%;
  min-height: 136rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 36rpx rgba(115, 72, 52, 0.08);
  box-sizing: border-box;
}

.profile-stat text {
  display: block;
  color: #8b7a72;
  font-size: 24rpx;
  font-weight: 800;
}

.profile-stat view {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 900;
}

.profile-options {
  padding: 10rpx 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #f0ddd3;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 36rpx rgba(115, 72, 52, 0.08);
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid #f0ddd3;
  font-weight: 900;
}

.option-label {
  flex: 0 0 auto;
  min-width: 160rpx;
  white-space: nowrap;
}

.option-arrow {
  flex: 0 0 auto;
  width: 32rpx;
  text-align: right;
}

.option:last-child {
  border-bottom: 0;
}

.unit {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #fff0e8;
  white-space: nowrap;
}

.unit button {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 54rpx;
  border-radius: 10rpx;
  background: transparent;
  color: #8b7a72;
  font-size: 24rpx;
  line-height: 1;
}

.unit button + button {
  margin-left: 8rpx;
}

.unit button.active {
  background: #fff;
  color: #b95549;
}

.logout {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(217, 80, 54, 0.26);
  border-radius: 16rpx;
  background: #fff2ec;
  color: #d86e5d;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 12rpx 26rpx rgba(115, 72, 52, 0.09);
}
