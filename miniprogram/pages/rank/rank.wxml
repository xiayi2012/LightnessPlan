<view class="page">
  <view class="topbar">
    <text class="eyebrow">好友 PK</text>
    <text class="title">排行榜</text>
  </view>

  <view class="race panel">
    <view>
      <text class="muted">{{competition.isFinished ? '比赛已结束' : '比赛进行中'}}</text>
      <view class="race-title">{{competition.isFinished ? '最终结果' : '当前赛况'}}</view>
      <text class="muted">{{competition.startDate}} 至 {{competition.endDate}}</text>
    </view>
    <view class="race-days">
      <text>剩余</text>
      <view>{{competition.isFinished ? 0 : competition.daysLeft}}</view>
      <text>天</text>
    </view>
  </view>

  <view class="grid-2">
    <view class="panel">
      <text class="muted">{{competition.isFinished ? '获胜者' : '当前第一'}}</text>
      <view class="winner-name">{{competition.winner.user.name || '--'}}</view>
      <text class="muted">{{competition.isFinished ? winnerScore : '比赛结束后公开数值'}}</text>
    </view>
    <view class="panel">
      <text class="muted">{{competition.isFinished ? '请客吃饭' : '请客候选'}}</text>
      <view class="winner-name">{{competition.loser.user.name || '--'}}</view>
      <text class="muted">{{competition.isFinished ? loserScore : '比赛结束后公开数值'}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="rank-tabs">
      <button class="rank-tab {{mode === 'dailyPercent' ? 'active' : ''}}" data-mode="dailyPercent" bindtap="changeMode">今日排行</button>
      <button class="rank-tab {{mode === 'totalLoss' ? 'active' : ''}}" data-mode="totalLoss" bindtap="changeMode">总排行</button>
    </view>
    <block wx:if="{{leaderboard.length}}">
      <view class="rank-item top-{{index + 1}} {{item.own ? 'own' : ''}}" wx:for="{{leaderboard}}" wx:key="user.id">
        <view class="badge">{{index + 1}}</view>
        <view class="rank-main">
          <view class="rank-name">{{item.user.name}}</view>
          <view wx:if="{{item.own}}" class="rank-meta">当前体重 {{item.weightText}} · 减重比例 {{item.percentText}}</view>
        </view>
        <view wx:if="{{item.own}}" class="rank-score">{{item.weightText}}</view>
      </view>
    </block>
    <view wx:else class="empty">{{mode === 'totalLoss' ? '还没有可排行的体重记录。' : '这个日期还没有可排行的今日减重比例。'}}</view>
  </view>
</view>
