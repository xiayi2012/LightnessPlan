.race {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 26rpx rgba(115, 72, 52, 0.09), 0 2rpx 8rpx rgba(115, 72, 52, 0.04);
}

.race > view:first-child {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.race-title,
.winner-name {
  margin: 10rpx 0;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.race-days {
  min-width: 184rpx;
  min-height: 172rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(233, 130, 110, 0.22);
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fff, #fff0e8);
  box-shadow: 0 14rpx 28rpx rgba(216, 110, 93, 0.13), 0 12rpx 26rpx rgba(115, 72, 52, 0.09);
  text-align: center;
  box-sizing: border-box;
}

.race-days view {
  color: #b95549;
  font-size: 68rpx;
  line-height: 1;
  font-weight: 900;
}

.rank-tabs {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.rank-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48.6%;
  height: 72rpx;
  padding: 0;
  border: 1rpx solid #f0ddd3;
  border-radius: 14rpx;
  background: #fff;
  color: #8b7a72;
  font-weight: 900;
  line-height: 1;
}

.rank-tab::after {
  border: 0;
}

.rank-tab.active {
  border-color: rgba(233, 130, 110, 0.24);
  background: #fff0e8;
  color: #b95549;
}

.top-1 {
  border-color: rgba(244, 193, 93, 0.55);
  background: linear-gradient(135deg, #fff, #fff7df);
  box-shadow: 0 12rpx 24rpx rgba(244, 193, 93, 0.13);
}

.top-2 {
  border-color: rgba(139, 122, 114, 0.28);
  background: linear-gradient(135deg, #fff, #f7f2ef);
}

.top-3 {
  border-color: rgba(233, 130, 110, 0.22);
  background: linear-gradient(135deg, #fff, #fff0e8);
}

.own {
  border-color: rgba(233, 130, 110, 0.42);
}

.rank-score {
  color: #b95549;
  font-weight: 900;
}
