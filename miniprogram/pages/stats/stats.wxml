<view class="page">
  <view class="topbar">
    <text class="eyebrow">体重数据</text>
    <text class="title">统计</text>
  </view>

  <view class="panel">
    <view class="panel-title">数据统计</view>
    <view class="grid-2">
      <view class="stat card"><text class="stat-label">起始体重</text><text class="stat-value">{{firstWeight}}</text></view>
      <view class="stat card"><text class="stat-label">距目标</text><text class="stat-value">{{distanceToGoal}}</text></view>
      <view class="stat card"><text class="stat-label">平均变化</text><text class="stat-value">{{avgChange}}</text></view>
      <view class="stat card"><text class="stat-label">最佳单日</text><text class="stat-value">{{bestDay}}</text></view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">体重趋势</view>
    <view class="line-chart">
      <canvas wx:if="{{trend.length}}" type="2d" id="trendCanvas" class="trend-canvas"></canvas>
      <view wx:else class="empty">还没有足够的数据生成趋势图</view>
    </view>
    <view class="trend-labels" wx:if="{{trend.length}}">
      <text wx:for="{{trend}}" wx:key="date">{{item.shortDate}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">全部体重记录</view>
    <block wx:if="{{records.length}}">
      <view class="record" wx:for="{{records}}" wx:key="id">
        <view class="record-main">
          <view class="record-title">{{item.date}}</view>
          <view wx:if="{{item.note}}" class="record-meta">{{item.note}}</view>
        </view>
        <view class="record-title">{{item.weightText}}</view>
      </view>
    </block>
    <view wx:else class="empty">还没有体重记录</view>
  </view>
</view>
