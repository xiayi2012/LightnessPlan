.line-chart {
  width: 100%;
  height: 320rpx;
  padding: 10rpx 0 0;
  box-sizing: border-box;
}

.trend-canvas {
  width: 100%;
  height: 320rpx;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #8b7a72;
  font-size: 20rpx;
  font-weight: 800;
}

.trend-labels text {
  flex: 1;
  text-align: center;
}
